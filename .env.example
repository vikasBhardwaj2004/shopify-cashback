# ── Shopify App Credentials ───────────────────────────────────────────────────
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_SCOPES=read_orders,write_orders,read_customers,write_customers,read_discounts,write_discounts,write_price_rules
HOST=https://your-app-domain.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/cashback_db

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=your_very_long_random_secret_here

# ── Cron ──────────────────────────────────────────────────────────────────────
# Runs daily at midnight to expire cashback batches
EXPIRY_CRON_SCHEDULE=0 0 * * *
